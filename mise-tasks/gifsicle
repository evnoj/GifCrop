#!/bin/zsh
#MISE description="Build a universal (arm64 + x86_64) gifsicle into build/gifsicle"
#MISE sources=["mise-tasks/gifsicle"]
#MISE outputs=["build/gifsicle"]
set -euo pipefail

VERSION=1.98
BUILD="$MISE_PROJECT_ROOT/build"
SRC="$BUILD/gifsicle-$VERSION"

mkdir -p "$BUILD"
if [[ ! -d "$SRC" ]]; then
  curl -fsSL "https://www.lcdf.org/gifsicle/gifsicle-$VERSION.tar.gz" | tar -xz -C "$BUILD"
fi

cd "$SRC"
./configure --disable-gifview --disable-gifdiff \
  CFLAGS="-O2 -arch arm64 -arch x86_64 -mmacosx-version-min=12.0" >/dev/null
make -j"$(sysctl -n hw.ncpu)" >/dev/null
cp src/gifsicle "$BUILD/gifsicle"
