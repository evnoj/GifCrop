#!/bin/zsh
#MISE description="Tag the version in Support/Info.plist and publish it as a GitHub release with build/GifCrop.zip"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

VERSION=$(/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" Support/Info.plist)
TAG="v$VERSION"

fail() { print -u2 "release: $1"; exit 1; }

[[ $(git branch --show-current) == main ]] || fail "not on main"
[[ -z $(git status --porcelain --untracked-files=no) ]] || fail "uncommitted changes"
git fetch -q --tags origin
[[ -z $(git tag -l "$TAG") ]] || fail "$TAG already exists; bump CFBundleShortVersionString in Support/Info.plist"

# The CHANGELOG.md section for this version, without its heading.
CHANGES=$(awk -v heading="## [$VERSION]" '
  index($0, heading) == 1 { found = 1; next }
  found && /^## \[/ { exit }
  found && /^\[[^]]+\]: / { exit }
  found { print }
' CHANGELOG.md | sed -e '/./,$!d')
[[ -n $CHANGES ]] || fail "no \"## [$VERSION]\" section in CHANGELOG.md"

mise run package
SHA=$(shasum -a 256 build/GifCrop.zip | cut -d' ' -f1)

NOTES=$(mktemp)
trap 'rm -f "$NOTES"' EXIT
cat > "$NOTES" <<EOF
$CHANGES

### Installing

Requires macOS 12 or later; runs on Apple silicon and Intel. Download \`GifCrop.zip\`, unzip it, and move \`GifCrop.app\` to \`/Applications\`, replacing any older copy.

GifCrop isn't signed with an Apple Developer ID, so macOS will refuse to open it the first time. To allow it, either open System Settings → Privacy & Security and click "Open Anyway" next to the message about GifCrop, or run:

\`\`\`sh
xattr -dr com.apple.quarantine /Applications/GifCrop.app
\`\`\`

SHA-256 of \`GifCrop.zip\`: \`$SHA\`
EOF

git tag -a "$TAG" -m "GifCrop $VERSION"
git push origin main "$TAG"
gh release create "$TAG" build/GifCrop.zip --title "GifCrop $VERSION" --notes-file "$NOTES" --verify-tag
